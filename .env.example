# Copy to .env (never committed). All values are read through packages/core/src/config.ts.
STAGE=dev

# Supabase Postgres. Free-tier direct hosts (db.<ref>.supabase.co) are IPv6-only: always use the pooler.
# App traffic: transaction pooler 6543 (pgbouncer=true). Prisma migrations: session pooler 5432.
# A '#' in the password must be written %23.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Google OAuth client used for Gmail access (scope gmail.modify)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/google/callback
GOOGLE_PUBSUB_TOPIC=projects/<gcp-project>/topics/gmail-notifications

# AWS
AWS_REGION=ap-south-1
S3_BUCKET=
SQS_MESSAGES_QUEUE_URL=

# LLM
OPENAI_API_KEY=
MODEL_CLASSIFY=gpt-6-luna
MODEL_AGENT=gpt-6.1-sol

# Express
PORT=8080
# Session cookie HMAC key, >= 32 chars. Generate: openssl rand -base64 48
SESSION_SECRET=

# OpenTelemetry export (Grafana Cloud OTLP gateway). Leave ENDPOINT empty to disable export locally.
# HEADERS value = base64("<instance-id>:<glc_ token>"). Write any trailing '=' padding as %3D: the
# OTEL headers parser treats '=' as a key/value separator and would truncate the credential.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64>"
