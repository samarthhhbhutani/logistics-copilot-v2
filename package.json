{
  "name": "logistics-copilot-v2",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Logistics Copilot v2: Gmail ingestion, classification, RFQ fan-out and an AI drafting agent",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/contract",
    "packages/core",
    "apps/*",
    "infra"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "prepare": "husky",
    "db:generate": "npm run db:generate -w @lc/core",
    "db:migrate": "npm run db:migrate -w @lc/core --",
    "db:deploy": "npm run db:deploy -w @lc/core",
    "db:status": "npm run db:status -w @lc/core",
    "test:e2e": "npm run test:e2e -w @lc/frontend"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "prisma": "7.10.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
