// Tables are added one at a time as features need them (design doc, section 3).
// Column names stay snake_case in Postgres via @map; model fields are camelCase.

generator client {
  provider     = "prisma-client"
  output       = "../src/db/generated"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A customer organisation: one logistics desk. The unit of data isolation; every row a desk
/// owns carries its tenant_id and every query is scoped by it. Created once, with its first mailbox.
model Tenant {
  id                          String               @id @default(uuid()) @db.Uuid
  name                        String
  /// The desk's own Google OAuth client, created in its Workspace project with an Internal consent
  /// screen (no verification, no 7-day token expiry). One per tenant; every mailbox consents
  /// through it. Secret encrypted with createSecretCipher. Null only for tenants created before
  /// this column existed; connect refuses them until an operator sets the client.
  googleClientId              String?              @map("google_client_id")
  encryptedGoogleClientSecret String?              @map("encrypted_google_client_secret")
  /// Pub/Sub topic in the SAME Google project as the OAuth client (Gmail rejects any other project),
  /// `projects/<project>/topics/<topic>`; passed to users.watch for every mailbox of the tenant.
  pubsubTopicName             String?              @map("pubsub_topic_name")
  /// Service account the tenant's push subscription signs deliveries with; the push receiver accepts
  /// only OIDC tokens whose email matches. Both null for tenants created before Pub/Sub onboarding.
  pushServiceAccountEmail     String?              @map("push_service_account_email")
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz
  mailboxes                   Mailbox[]
  logins                      MailboxLogin[]
  emails                      Email[]
  attachments                 Attachment[]
  classificationRules         ClassificationRule[]
  classifications             Classification[]

  @@map("tenants")
}

/// not_connected: never consented or disconnected. connected: refresh token on file.
/// needs_reconnect: a refresh failed (revoked, password change, 7-day test expiry); the portal
/// shows a banner and the same connect flow repairs it.
enum GmailConnectionStatus {
  NOT_CONNECTED   @map("not_connected")
  CONNECTED       @map("connected")
  NEEDS_RECONNECT @map("needs_reconnect")

  @@map("gmail_connection_status")
}

/// The account a person operates: one Gmail inbox, one login, one person. The identity of the
/// product. email_address is the only place the address lives and doubles as the login name.
/// Exists from creation (by us); encrypted_refresh_token stays null until Gmail is connected, and
/// connect must reject a Google account whose address differs from email_address.
/// last_history_id is the Pub/Sub cursor; only the ingest Lambda advances it, with
/// updateMany({ where: { id, lastHistoryId: { lt: new } } }).
model Mailbox {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  tenant                Tenant                @relation(fields: [tenantId], references: [id])
  emailAddress          String                @unique @map("email_address")
  encryptedRefreshToken String?               @map("encrypted_refresh_token")
  gmailConnectionStatus GmailConnectionStatus @default(NOT_CONNECTED) @map("gmail_connection_status")
  gmailConnectedAt      DateTime?             @map("gmail_connected_at") @db.Timestamptz
  lastHistoryId         BigInt?               @map("last_history_id")
  watchExpiresAt        DateTime?             @map("watch_expires_at") @db.Timestamptz
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  login                 MailboxLogin?
  emails                Email[]

  @@index([tenantId])
  @@map("mailboxes")
}

/// Password credential for one mailbox, and nothing else (no Google tokens here). Kept apart from
/// mailboxes so the ingest Lambda's cursor writes never touch the row holding the password hash.
/// password_hash is argon2id (packages/core/src/auth/passwordHash.ts).
model MailboxLogin {
  id           String   @id @default(uuid()) @db.Uuid
  mailboxId    String   @unique @map("mailbox_id") @db.Uuid
  mailbox      Mailbox  @relation(fields: [mailboxId], references: [id])
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId])
  @@map("mailbox_logins")
}

/// Which Gmail folder the message was in when it arrived: inbox = received by the mailbox owner,
/// sent = written by them (Gmail UI or our send path). The ingest watch covers only these two.
/// A snapshot at ingest; later label changes (read, archived, user labels) are not followed.
enum GmailLabel {
  INBOX @map("inbox")
  SENT  @map("sent")

  @@map("gmail_label")
}

/// One RFC 822 message as it arrived in one mailbox: what the portal lists and the classifier reads.
/// The same mail reaching two mailboxes of a tenant is two rows (display is per mailbox) with the
/// same rfc_message_id. gmail_message_id is Gmail's id for this mailbox's copy, so
/// (mailbox_id, gmail_message_id) is the idempotency key the processor inserts on. The full raw
/// message lives in S3 at raw_email_s3_key; headers not stored here can be re-read from it.
/// to_recipients / cc_recipients are EmailAddress[] ({ name, address }, address lowercased).
model Email {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  mailboxId       String           @map("mailbox_id") @db.Uuid
  mailbox         Mailbox          @relation(fields: [mailboxId], references: [id])
  gmailMessageId  String           @map("gmail_message_id")
  gmailThreadId   String           @map("gmail_thread_id")
  gmailLabel      GmailLabel       @map("gmail_label")
  /// The Message-ID header; how our own sent RFQs are recognised when their SENT copy arrives.
  rfcMessageId    String?          @map("rfc_message_id")
  /// Empty string when the From header had only an address; null address when From was missing.
  senderName      String           @map("sender_name")
  senderEmail     String?          @map("sender_email")
  toRecipients    Json             @map("to_recipients")
  ccRecipients    Json             @map("cc_recipients")
  subject         String
  /// Gmail's own short plain-text preview, for list views that must not load body_text.
  snippet         String
  bodyText        String           @map("body_text")
  bodyHtml        String?          @map("body_html")
  rawEmailS3Key   String           @map("raw_email_s3_key")
  /// The Date header, or Gmail's internalDate when the header is missing or unparseable.
  receivedAt      DateTime         @map("received_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  attachments     Attachment[]
  classifications Classification[]

  @@unique([mailboxId, gmailMessageId])
  @@index([mailboxId, receivedAt])
  @@index([mailboxId, gmailThreadId])
  @@index([tenantId])
  @@map("emails")
}

/// One MIME part of an email stored as a file. Content lives in S3 under the tenant, addressed by
/// its sha256, so the same file sent many times is stored once; rows are per email. Inline parts
/// (cid: images referenced from the HTML body) are kept too, flagged, so a thread view can render
/// them and a file list can hide them.
model Attachment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  emailId     String   @map("email_id") @db.Uuid
  email       Email    @relation(fields: [emailId], references: [id])
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  /// Lowercase hex of the content; also the last path segment of s3_key.
  sha256      String
  s3Key       String   @map("s3_key")
  contentId   String?  @map("content_id")
  isInline    Boolean  @map("is_inline")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([emailId])
  @@index([tenantId, sha256])
  @@map("attachments")
}

/// What an inbound mail is for the desk. general = everything else; customer_request = a shipper
/// asking for a quote or a booking (the RFQ entry point); customer_reply = a later inbound mail in
/// a thread that already holds a customer_request, derived from the thread, never by rule or LLM;
/// rate_card = an unsolicited price list from a vendor. Vendor replies to RFQs we sent are linked
/// by thread, not classified.
enum ClassificationLabel {
  GENERAL          @map("general")
  CUSTOMER_REQUEST @map("customer_request")
  CUSTOMER_REPLY   @map("customer_reply")
  RATE_CARD        @map("rate_card")

  @@map("classification_label")
}

/// Who decided the label: the thread it arrived in (customer_reply), a tenant rule, the LLM, or an
/// operator correcting it in the portal.
enum ClassificationSource {
  THREAD @map("thread")
  RULE   @map("rule")
  LLM    @map("llm")
  USER   @map("user")

  @@map("classification_source")
}

/// A tenant's deterministic classifier: "mail from this sender is this label". Rules run before
/// any LLM, lowest priority value first; the first match wins. sender_pattern is compared
/// case-insensitively against the sender address: a value containing "@" must equal the whole
/// address, anything else must equal the domain after the "@". Disabled rules are kept, not deleted,
/// so classifications.rule_id keeps pointing at what decided a label.
model ClassificationRule {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  priority        Int
  senderPattern   String              @map("sender_pattern")
  label           ClassificationLabel
  enabled         Boolean             @default(true)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  classifications Classification[]

  @@unique([tenantId, senderPattern])
  @@index([tenantId, enabled, priority])
  @@map("classification_rules")
}

/// One labelling of one email. Append-only: a correction is a new row with source=user, and the
/// current label is the newest row, so the history of who said what is kept. Rule rows carry
/// rule_id (a rule with classifications cannot be deleted; disable it); LLM rows will carry
/// llm_model, prompt_version and confidence.
model Classification {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  emailId       String               @map("email_id") @db.Uuid
  email         Email                @relation(fields: [emailId], references: [id])
  label         ClassificationLabel
  source        ClassificationSource
  ruleId        String?              @map("rule_id") @db.Uuid
  rule          ClassificationRule?  @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  llmModel      String?              @map("llm_model")
  promptVersion String?              @map("prompt_version")
  confidence    Float?
  classifiedAt  DateTime             @default(now()) @map("classified_at") @db.Timestamptz

  @@index([emailId, classifiedAt(sort: Desc)])
  @@index([tenantId])
  @@map("classifications")
}
